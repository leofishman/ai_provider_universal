msgstr "Cualquier página, en este sitio o en otro lugar. Su contenido de texto se extrae y se analiza."

msgid "Or paste text"
msgstr "O pegue texto"

msgid "Used when no URL is given."
msgstr "Se usa cuando no se proporciona una URL."

msgid "Provide a URL or paste some text."
msgstr "Proporcione una URL o pegue texto."

msgid "Pasted text"
msgstr "Texto pegado"

msgid "No usable text found — nothing to scan."
msgstr "No se encontró texto utilizable — nada que analizar."

msgid "Could not fetch %url: @message"
msgstr "No se pudo obtener %url: @message"

msgid "Extracted @count factual claims."
msgstr "Se extrajeron @count afirmaciones factuales."

