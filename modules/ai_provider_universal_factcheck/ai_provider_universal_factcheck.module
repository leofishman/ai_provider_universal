<?php

/**
 * @file
 * Hooks for the AI Provider Universal Fact Check module.
 */

/**
 * Implements hook_mail().
 */
function ai_provider_universal_factcheck_mail($key, &$message, $params) {
  $message['subject'] = $params['subject'];
  $message['body'][] = $params['body'];
}

/**
 * Sends an admin alert email.
 *
 * Best effort — never breaks the calling flow. Email only, no other
 * channels; add one here if a site needs it.
 */
function ai_provider_universal_factcheck_notify(string $key, string $subject, string $body): void {
  $to = \Drupal::config('ai_provider_universal_factcheck.settings')->get('notify_email');
  if (!$to) {
    return;
  }
  try {
    \Drupal::service('plugin.manager.mail')->mail(
      'ai_provider_universal_factcheck',
      $key,
      $to,
      \Drupal::languageManager()->getDefaultLanguage()->getId(),
      ['subject' => $subject, 'body' => $body]
    );
  }
  catch (\Throwable $e) {
    \Drupal::logger('ai_provider_universal_factcheck')->warning('Could not send notification email: @message', ['@message' => $e->getMessage()]);
  }
}
