<?php

/**
 * @file
 * Hooks for ai_provider_universal_router.
 */

use Drupal\Core\Entity\EntityInterface;

/**
 * Clears the AI provider cache when Smart Routes change.
 *
 * New/updated routes then appear immediately in model dropdowns (including
 * Factcheck settings) without requiring a full cache rebuild from users.
 */
function _ai_provider_universal_router_clear_ai_cache(): void {
  if (\Drupal::hasService('ai.provider')) {
    \Drupal::service('ai.provider')->clearCachedDefinitions();
  }
}

/**
 * Implements hook_entity_insert().
 */
function ai_provider_universal_router_entity_insert(EntityInterface $entity): void {
  if ($entity->getEntityTypeId() === 'ai_universal_route') {
    _ai_provider_universal_router_clear_ai_cache();
  }
}

/**
 * Implements hook_entity_update().
 */
function ai_provider_universal_router_entity_update(EntityInterface $entity): void {
  if ($entity->getEntityTypeId() === 'ai_universal_route') {
    _ai_provider_universal_router_clear_ai_cache();
  }
}

/**
 * Implements hook_entity_delete().
 */
function ai_provider_universal_router_entity_delete(EntityInterface $entity): void {
  if ($entity->getEntityTypeId() === 'ai_universal_route') {
    _ai_provider_universal_router_clear_ai_cache();
  }
}
