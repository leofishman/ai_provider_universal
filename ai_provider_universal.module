<?php

/**
 * @file
 * Hooks for the universal AI provider module.
 */

use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\ai_provider_universal\Hook\AiProviderUniversalHooks;

/**
 * Implements hook_entity_insert().
 */
#[LegacyHook]
function ai_provider_universal_entity_insert(EntityInterface $entity): void {
  \Drupal::service(AiProviderUniversalHooks::class)->entityInsert($entity);
}

/**
 * Implements hook_entity_update().
 */
#[LegacyHook]
function ai_provider_universal_entity_update(EntityInterface $entity): void {
  \Drupal::service(AiProviderUniversalHooks::class)->entityUpdate($entity);
}

/**
 * Implements hook_entity_delete().
 */
#[LegacyHook]
function ai_provider_universal_entity_delete(EntityInterface $entity): void {
  \Drupal::service(AiProviderUniversalHooks::class)->entityDelete($entity);
}
