{
  "name": "drupal/ai_provider_universal",
  "description": "Universal multi-instance AI provider for Drupal: OpenAI-compatible servers today, any protocol via backend plugins.",
  "type": "drupal-module",
  "require": {
    "php": "^8.3",
    "drupal/ai": "^1.3.0",
    "drupal/key": "^1.18"
  },
  "extra": {
    "patches": {
      "drupal/ai": {
        "Fix AiSettingsForm model validity check for optgrouped (server-grouped) model options": "patches/ai-support-optgrouped-model-options.patch",
        "Fix ai_search embeddings_engine parsing for model ids containing double underscores (explode limit 2)": "patches/ai-search-embeddings-engine-explode-limit.patch"
      }
    }
  }
}