includes:
  - phar://phpstan.phar/conf/bleedingEdge.neon

parameters:
  level: 1

  paths:
    - .

  # The Decision submodule builds on AI 1.6, which CI does not install yet
  # (composer resolves the latest stable). Drop this once AI 1.6 is stable.
  excludePaths:
    - modules/ai_provider_universal_decision

  fileExtensions:
    - php
    - module
    - inc
    - install

  ignoreErrors:
    - '#Unsafe usage of new static\(\)#'
    # Deliberate ai <= 1.3 fallbacks in GuardrailDefaultsSubscriber; only
    # reported when analyzing against ai >= 1.4 (e.g. drupal.org CI).
    -
      message: '#deprecated method (getGuardrailSet|setGuardrailSet)\(\)#'
      reportUnmatched: false
