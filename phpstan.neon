includes:
  - phar://phpstan.phar/conf/bleedingEdge.neon

parameters:
  level: 1

  paths:
    - .

  fileExtensions:
    - php
    - module
    - inc
    - install

  ignoreErrors:
    - '#Unsafe usage of new static\(\)#'
    # Deliberate ai <= 1.3 fallbacks in GuardrailDefaultsSubscriber; only
    # reported when analysing against ai >= 1.4 (e.g. drupal.org CI).
    -
      message: '#deprecated method (getGuardrailSet|setGuardrailSet)\(\)#'
      reportUnmatched: false
